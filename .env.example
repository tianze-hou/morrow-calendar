# 本地开发用的环境变量样例。复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 生产部署请改用 deploy/morrow-calendar.env.example，两份内容基本一致。

# 监听端口。前端 Vite 会把 /api 反代到这个端口。
PORT=8787

# 数据库文件路径。默认 ./data/calendar.db
# DB_PATH=./data/calendar.db

# 服务端默认时区，影响不带偏移的时间串如何解析
TZ_NAME=Asia/Shanghai

# SQLite 驱动：留空=自动（优先 better-sqlite3，装不上回退 node-sqlite3-wasm）
# 也可明确写 better-sqlite3 或 wasm
# DB_DRIVER=

# ── 鉴权 ──────────────────────────────────────────────────────
# 默认开启。本地单人、不对外时可设为 false 免登录（所有请求算作本机用户）。
AUTH_ENABLED=true

# 首个管理员。留空 ADMIN_PASSWORD 时服务端不建号：首次打开网页会显示「初始化」
# 向导，由你在浏览器里创建。容器 / CI / 无浏览器环境请设上它，服务端会照旧自动
# 建号并把口令打进启动横幅。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 会话有效期（天）与 cookie 名
SESSION_DAYS=30
SESSION_COOKIE=morrow_session

# 走 HTTPS 时置 true（NODE_ENV=production 默认 true）。
# HTTP 直连访问时必须置 false，否则浏览器不会回传 cookie。
COOKIE_SECURE=false

# ── 配额 ──────────────────────────────────────────────────────
MAX_BATCH_SIZE=50
MAX_CALENDARS=20
MAX_TOKENS=10

# 仅当前端部署在另一个域时才需要，逗号分隔的白名单。留空表示不启用跨域。
# CORS_ORIGINS=https://app.example.com
