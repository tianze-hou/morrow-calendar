# 复制为 /etc/morrow-calendar.env，按实际环境改值
# 服务监听端口。反向代理把 80/443 指到这个端口。
PORT=8787

# 数据库文件位置。必须放在代码目录之外，避免重新部署时被覆盖。
DB_PATH=/var/lib/morrow-calendar/calendar.db

# 服务端默认时区
TZ_NAME=Asia/Shanghai

# SQLite 驱动：留空=自动（优先原生 better-sqlite3，装不上则回退 node-sqlite3-wasm）
# 也可明确写 better-sqlite3 或 wasm，此时装不上会直接启动失败而不是静默降级。
DB_DRIVER=

# 批量接口单次上限
MAX_BATCH_SIZE=50

# ── 多用户鉴权 ────────────────────────────────────────────────
# 默认开启。仅在「本机单人、不对外」时才建议关掉（关掉后免登录，所有请求算作本地用户）。
AUTH_ENABLED=true

# 初始化引导预填的管理员用户名
ADMIN_USERNAME=admin

# 留空：服务端不建号，首个管理员改由浏览器「初始化」向导创建（适合能打开网页的场景）。
# 设上：服务端自动建号，不再走浏览器引导——容器 / CI / 无浏览器环境建议这么配。
# 长度至少 8 位，可以这么生成：openssl rand -base64 18
ADMIN_PASSWORD=

# 会话有效期（天）
SESSION_DAYS=30

# 会话 cookie 名
SESSION_COOKIE=morrow_session

# 走 HTTPS 时置 true，cookie 会带 Secure 属性。NODE_ENV=production 时默认 true。
# 若在 HTTP 后面（比如内网直连 IP）访问，必须置 false，否则浏览器不会回传 cookie。
COOKIE_SECURE=false

# ── 配额 ──────────────────────────────────────────────────────
# 每个用户最多能建几个日历分组
MAX_CALENDARS=20

# 每个用户最多能持有几个有效 API 令牌
MAX_TOKENS=10

# 生产环境标识
NODE_ENV=production
